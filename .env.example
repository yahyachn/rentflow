# Copy to .env and fill in real values.

# MySQL/MariaDB connection string. For XAMPP's default local setup (root
# user, no password, port 3306) that's:
#   DATABASE_URL="mysql://root@localhost:3306/rentflow"
# For a MySQL user you created yourself:
# Deploying to Vercel (or any serverless host): this MUST point at a
# reachable hosted MySQL/MariaDB instance (PlanetScale, Railway, AWS RDS,
# etc.) — Vercel's functions can't reach "localhost" on your own machine.
DATABASE_URL="mysql://user:password@localhost:3306/rentflow"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-string"
# Deploying: set both of these to your real deployed URL (e.g.
# https://your-app.vercel.app), not localhost.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (vehicle image uploads). Optional for local dev — without it,
# uploads fall back to local disk storage (app/api/uploads/route.ts).
# On Vercel (or any serverless host) that fallback does NOT work — the
# filesystem there is read-only/ephemeral, so uploaded images would 404
# almost immediately. Set these three before deploying anywhere serverless.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (transactional email). Get RESEND_API_KEY from the Resend dashboard
# (API Keys). RESEND_FROM must be a verified sender, e.g.
#   RESEND_FROM="RentFlow <noreply@yourdomain.com>"
# For a quick test without a domain, Resend allows: onboarding@resend.dev
# Leave both blank to keep outbound emails queued (PENDING) instead of sent.
RESEND_API_KEY=""
RESEND_FROM=""
